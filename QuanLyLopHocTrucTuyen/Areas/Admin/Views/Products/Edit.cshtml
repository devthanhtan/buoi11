@model ProductFormViewModel
@{
    ViewData["Title"] = "Sửa khóa học";
}

<div class="card shadow-sm">
    <div class="card-header bg-white"><strong>Sửa khóa học: @Model.TenKhoaHoc</strong></div>
    <div class="card-body">
        <form asp-action="Edit" asp-route-id="@Model.MaKhoaHoc" method="post">
            <partial name="_ProductForm" model="Model" />
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

