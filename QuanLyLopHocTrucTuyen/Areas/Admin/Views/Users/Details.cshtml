@model NguoiDung
@{
    ViewData["Title"] = "Chi tiết người dùng";
}

<div class="mb-3 d-flex gap-2">
    <a asp-action="Index" class="btn btn-sm btn-outline-secondary"><i class="bi bi-arrow-left"></i> Quay lại</a>
    <a asp-action="Edit" asp-route-id="@Model.MaNguoiDung" class="btn btn-sm btn-warning"><i class="bi bi-pencil"></i> Sửa thông tin</a>
</div>

<div class="row g-3">
    <div class="col-md-4">
        <div class="card shadow-sm text-center">
            <div class="card-body">
                <img src="@(Model.AnhDaiDien ?? "https://placehold.co/150")" class="rounded-circle mb-3" width="120" height="120" alt="" />
                <h5>@Model.HoTen</h5>
                <span class="badge bg-primary">@Model.VaiTro?.TenVaiTro</span>
                <p class="text-muted mt-3 mb-0">@Model.GioiThieu</p>
            </div>
        </div>
    </div>
    <div class="col-md-8">
        <div class="card shadow-sm">
            <div class="card-header bg-white"><strong>Thông tin tài khoản</strong></div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-4">Mã người dùng</dt>
                    <dd class="col-sm-8">@Model.MaNguoiDung</dd>

                    <dt class="col-sm-4">Email</dt>
                    <dd class="col-sm-8">@Model.Email</dd>

                    <dt class="col-sm-4">Số điện thoại</dt>
                    <dd class="col-sm-8">@(Model.SoDienThoai ?? "—")</dd>

                    <dt class="col-sm-4">Phương thức đăng nhập</dt>
                    <dd class="col-sm-8">@Model.PhuongThucDangNhap</dd>

                    <dt class="col-sm-4">Đã kích hoạt</dt>
                    <dd class="col-sm-8">@(Model.DaKichHoat ? "Có" : "Chưa")</dd>

                    <dt class="col-sm-4">Trạng thái</dt>
                    <dd class="col-sm-8">@(Model.TrangThai ? "Hoạt động" : "Bị khóa")</dd>

                    <dt class="col-sm-4">Ngày tạo</dt>
                    <dd class="col-sm-8">@Model.NgayTao.ToString("dd/MM/yyyy HH:mm")</dd>
                </dl>
            </div>
        </div>

        @if (Model.KhoaHocs.Any())
        {
            <div class="card shadow-sm mt-3">
                <div class="card-header bg-white"><strong>Khóa học đang giảng dạy</strong></div>
                <ul class="list-group list-group-flush">
                    @foreach (var k in Model.KhoaHocs)
                    {
                        <li class="list-group-item d-flex justify-content-between">
                            <a asp-controller="Products" asp-action="Details" asp-route-id="@k.MaKhoaHoc">@k.TenKhoaHoc</a>
                            <span class="badge bg-light text-dark">@k.TrangThai</span>
                        </li>
                    }
                </ul>
            </div>
        }
    </div>
</div>

