@model UserFormViewModel
@{
    ViewData["Title"] = "Sửa người dùng";
}

<div class="card shadow-sm">
    <div class="card-header bg-white"><strong>Sửa người dùng: @Model.HoTen</strong></div>
    <div class="card-body">
        <form asp-action="Edit" asp-route-id="@Model.MaNguoiDung" method="post">
            <partial name="_UserForm" model="Model" />
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

